{
  "out_dir": "../assets",
  "facts_from": "readme-facts.json",
  "hero": {
    "name": "hero",
    "title": "Fleet Pulse — Trucking Operations on Databricks",
    "eyebrow": "{trips} trips  ·  {routes} routes  ·  2022–2024",
    "subtitle": "A medallion lakehouse on Lakeflow Declarative Pipelines, with a governed metric-view layer, a Genie agent and an AI/BI dashboard on top. Every figure reconciles to the trip facts.",
    "note": "14 bronze · 1 silver · 5 gold · 4 metric views",
    "accent": "primary"
  },
  "cards": {
    "name": "why",
    "label": "Why this project is worth a look",
    "cards": [
      {
        "icon": "◆",
        "title": "One source of truth",
        "body": "All four metric views read the same trip fact, so revenue, trips and MPG agree across every view and the dashboard.",
        "stat": "{revenue} · {trips} trips",
        "colour": "good"
      },
      {
        "icon": "▲",
        "title": "Reconciled, not assumed",
        "body": "The dataset's own monthly aggregates disagreed with the facts by {source_revenue_delta} on revenue. Finding that was the point.",
        "stat": "{source_revenue_delta} revenue gap found",
        "colour": "warn"
      },
      {
        "icon": "●",
        "title": "Governed KPIs",
        "body": "Ratios are MEASURE(a) / MEASURE(b) over atomic sums — never an average of an average, which is where MPG silently drifts.",
        "stat": "{metric_views} metric views · {benchmarks} benchmarks",
        "colour": "violet"
      }
    ]
  },
  "captions": [
    {
      "name": "section-pipeline",
      "eyebrow": "Part 1",
      "title": "The pipeline",
      "body": "Yearly CSV batches land in a Unity Catalog volume and become bronze streaming tables, one silver fact and five gold outputs on Lakeflow Declarative Pipelines.",
      "accent": "primary"
    },
    {
      "name": "section-optimizations",
      "eyebrow": "Part 2",
      "title": "Optimizations",
      "body": "Eight pipeline choices with measured reasons — clustering, write sizing, data quality gates, and one error that proved the two clustering clauses cannot coexist.",
      "accent": "cyan"
    },
    {
      "name": "section-semantic",
      "eyebrow": "Part 3",
      "title": "The semantic layer",
      "body": "Four governed metric views own the KPI definitions. Ratios compose from atomic measures, so they re-aggregate correctly at any dimension.",
      "accent": "violet"
    },
    {
      "name": "section-genie",
      "eyebrow": "Part 4",
      "title": "The Genie agent",
      "body": "Natural language over the same governed measures, held to account by seven benchmarks with checked SQL ground truth.",
      "accent": "good"
    },
    {
      "name": "section-dashboard",
      "eyebrow": "Part 5",
      "title": "The dashboard",
      "body": "Four KPIs, two trends, two rankings and two tables — with the agent reachable from an Ask Genie button.",
      "accent": "warn"
    },
    {
      "name": "section-run",
      "eyebrow": "Part 6",
      "title": "Run it yourself",
      "body": "Regenerate the data, deploy the bundle, recreate the views and open the report. Roughly fifteen minutes on a fresh workspace.",
      "accent": "bad"
    }
  ],
