{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Fleet KPIs (all time)",
      "queryLines": [
        "SELECT MEASURE(`Total Revenue`) AS total_revenue, ",
        "MEASURE(`Total Trips`) AS total_trips, ",
        "MEASURE(`On Time Rate`) AS on_time_rate, ",
        "MEASURE(`Average MPG`) AS avg_mpg ",
        "FROM trip_metrics"
      ]
    },
    {
      "name": "ds_monthly",
      "displayName": "Monthly operations trend",
      "queryLines": [
        "SELECT `Trip Month` AS month, ",
        "MEASURE(`Total Revenue`) AS revenue, ",
        "MEASURE(`Total Trips`) AS trips, ",
        "MEASURE(`On Time Rate`) AS on_time_rate, ",
        "MEASURE(`Average MPG`) AS mpg ",
        "FROM trip_metrics ",
        "GROUP BY ALL ORDER BY month"
      ]
    },
    {
      "name": "ds_routes",
      "displayName": "Top routes by revenue per mile",
      "queryLines": [
        "SELECT Route, ",
        "`Origin City` AS origin_city, ",
        "`Destination City` AS destination_city, ",
        "MEASURE(`Revenue Per Mile`) AS revenue_per_mile, ",
        "MEASURE(`Total Revenue`) AS revenue ",
        "FROM trip_metrics ",
        "GROUP BY ALL ORDER BY revenue_per_mile DESC LIMIT 10"
      ]
    },
    {
      "name": "ds_customers",
      "displayName": "Customers with weakest on-time rate",
      "queryLines": [
        "SELECT `Customer Name` AS customer_name, ",
        "MEASURE(`On Time Rate`) AS on_time_rate, ",
        "MEASURE(`Total Revenue`) AS revenue ",
        "FROM trip_metrics ",
        "GROUP BY ALL ORDER BY on_time_rate ASC LIMIT 10"
      ]
    },
    {
      "name": "ds_drivers",
      "displayName": "Driver scorecard",
      "queryLines": [
        "SELECT Driver, ",
        "MEASURE(`Total Revenue`) AS revenue, ",
        "MEASURE(`Average MPG`) AS mpg, ",
        "MEASURE(`On Time Rate`) AS on_time_rate, ",
        "MEASURE(`Trips Completed`) AS trips ",
        "FROM driver_metrics ",
        "WHERE Driver <> 'Unassigned' ",
        "GROUP BY ALL ORDER BY revenue DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_trucks",
      "displayName": "Truck maintenance and downtime",
      "queryLines": [
        "SELECT Truck, ",
        "MEASURE(`Maintenance Cost`) AS maintenance_cost, ",
        "MEASURE(`Downtime Hours`) AS downtime_hours, ",
        "MEASURE(`Maintenance Events`) AS maintenance_events ",
        "FROM truck_maintenance_metrics ",
        "GROUP BY ALL ORDER BY downtime_hours DESC LIMIT 15"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Operations overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# Fleet Pulse — Trucking Operations (2022–2024)\n"
              ]
            }
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "subtitle",
            "multilineTextboxSpec": {
              "lines": [
                "**85,410 trips across 58 routes.** Medallion pipeline (14 bronze → 1 silver → 5 gold) on Lakeflow Declarative Pipelines, served through 4 governed Unity Catalog metric views. Every figure below reconciles to the trip facts — click **Ask Genie** to interrogate the same semantic layer in natural language.\n"
              ]
            }
          },
          "position": {"x": 0, "y": 1, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "kpi-revenue",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_kpi",
                "fields": [{"name": "total_revenue", "expression": "`total_revenue`"}],
                "disaggregated": true
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_revenue",
                  "displayName": "Total Revenue",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {"type": "max", "places": 2}
                  }
                }
              },
              "frame": {"title": "Total Revenue", "showTitle": true}
            }
          },
          "position": {"x": 0, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-trips",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_kpi",
                "fields": [{"name": "total_trips", "expression": "`total_trips`"}],
                "disaggregated": true
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_trips",
                  "displayName": "Trips Completed",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact",
                    "decimalPlaces": {"type": "max", "places": 0}
                  }
                }
              },
              "frame": {"title": "Trips Completed", "showTitle": true}
            }
          },
          "position": {"x": 3, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-ontime",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_kpi",
                "fields": [{"name": "on_time_rate", "expression": "`on_time_rate`"}],
                "disaggregated": true
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "on_time_rate",
                  "displayName": "On-Time Delivery",
                  "format": {"type": "number-percent", "decimalPlaces": {"type": "max", "places": 1}}
                }
              },
              "frame": {"title": "On-Time Delivery", "showTitle": true}
            }
          },
          "position": {"x": 6, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-mpg",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_kpi",
                "fields": [{"name": "avg_mpg", "expression": "`avg_mpg`"}],
                "disaggregated": true
              }
            }],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "avg_mpg",
                  "displayName": "Fleet MPG",
                  "format": {"type": "number-plain", "decimalPlaces": {"type": "max", "places": 2}, "formatTemplate": "{{ @formatted }} mpg"}
                }
              },
              "frame": {"title": "Fleet Fuel Efficiency", "showTitle": true}
            }
          },
          "position": {"x": 9, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "chart-revenue-trend",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_monthly",
                "fields": [
                  {"name": "month", "expression": "`month`"},
                  {"name": "revenue", "expression": "`revenue`"}
                ],
                "disaggregated": true,
                "orders": [{"direction": "ASC", "expression": "`month`"}]
              }
            }],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {"fieldName": "month", "scale": {"type": "temporal"}, "displayName": "Month"},
                "y": {"fieldName": "revenue", "scale": {"type": "quantitative"}, "displayName": "Revenue"}
              },
              "frame": {"title": "Monthly Revenue", "showTitle": true}
            }
          },
          "position": {"x": 0, "y": 5, "width": 8, "height": 5}
        },
        {
          "widget": {
            "name": "chart-mpg-trend",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "ds_monthly",
                "fields": [
                  {"name": "month", "expression": "`month`"},
                  {"name": "mpg", "expression": "`mpg`"}
                ],
                "disaggregated": true,
                "orders": [{"direction": "ASC", "expression": "`month`"}]
