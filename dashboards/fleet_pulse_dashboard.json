            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {"fieldName": "month", "scale": {"type": "temporal"}, "displayName": "Month"},
                "y": {"fieldName": "mpg", "scale": {"type": "quantitative"}, "displayName": "MPG"}
